# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Platform renderer
# Credential the shared renderer authenticates with. Applied on boot: setting it
# here is what makes the platform renderer usable, and changing it rotates the
# credential. Leave it empty and the renderer simply cannot connect.
# Generate one with:
#   printf 'mxr_%s_%s\n' "$(openssl rand -hex 6)" "$(openssl rand -hex 32)"
PLATFORM_RENDERER_TOKEN=

# Database (defaults match compose.yml at the repository root)
DB_HOST=localhost
DB_PORT=5432
DB_USER=matrixled
DB_PASSWORD=matrixled
DB_DATABASE=matrixled

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000