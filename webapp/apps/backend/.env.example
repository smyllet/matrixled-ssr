# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (defaults match compose.yml at the repository root)
DB_HOST=localhost
DB_PORT=5432
DB_USER=matrixled
DB_PASSWORD=matrixled
DB_DATABASE=matrixled

