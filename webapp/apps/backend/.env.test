# Configuration of the test suite. Committed on purpose: it holds no secret,
# only the credentials of the local PostgreSQL from compose.yml.

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=test

# App
LOG_LEVEL=silent
# Throwaway key: the suite needs a valid one, it protects nothing.
APP_KEY=Ptem5MJ+q1FCMuGYUu0ScDsxYbSaCyd8
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=memory

# Database — dedicated, never the development one. tests/bootstrap.ts refuses
# to run against a database whose name does not end with "_test".
DB_HOST=localhost
DB_PORT=5432
DB_USER=matrixled
DB_PASSWORD=matrixled
DB_DATABASE=matrixled_test
